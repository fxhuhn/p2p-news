# Environment configuration for P2P News & Editorial Pipeline
# Copy this file to .env and configure your credentials.

# Gemini API Key (Required for Stage 1 Digest & Stage 2 Editorial generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Git & GitHub Auto-Push (Phase 1 Distribution)
# Set to 'true' to push generated newsletters & rankings back to GitHub (default: true)
GIT_PUSH_ENABLED=true

# GitHub Personal Access Token (PAT) with 'repo' / 'contents:write' scope
# Required for automated commits from Docker containers without mounted .git directory
GITHUB_TOKEN=your_github_token_here

# Target GitHub Repository & Branch
GITHUB_REPOSITORY=fxhuhn/p2p-news
GIT_BRANCH=main

# Commit Author Information
GIT_AUTHOR_NAME="P2P News Automation"
GIT_AUTHOR_EMAIL="bot@p2p-news.local"
